{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tbr",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tbr-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "out",
        "-l",
        "4200"
      ],
      "port": 4200,
      "autoPort": true
    }
  ]
}